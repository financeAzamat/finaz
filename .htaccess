# Apache config for Beget (or any Apache host). GitHub Pages ignores this file.
#
# The site is deployed by checking the repo out INTO the web root, which puts a
# .git directory inside a publicly served folder. Apache would happily serve
# .git/config and .git/HEAD, so block every dotfile path outright. The repo is
# public, so the exposure is low — but a served .git is still a bad default.
RedirectMatch 404 /\.git
RedirectMatch 404 /\.htaccess
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Text assets compress well and the pages are hand-written HTML.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# Static site, no build fingerprinting: keep HTML short-lived so edits appear,
# and let CSS/JS/images cache longer (they are busted with ?v= when changed).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
